<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>10</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Service Include="{82A7F48D-3B50-4B1E-B82E-3ADA8210C358}" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Framework\Framework.csproj" />
    <ProjectReference Include="..\Hedra\Hedra.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="test_model.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
    <PackageReference Include="Moq" Version="4.9.0" />
    <PackageReference Include="NUnit.ConsoleRunner" Version="3.8.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.1.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="5.0.0" />
    <PackageReference Include="NUnit" Version="3.13.2" />
  </ItemGroup>
  <Target Name="CopyPackedHedraAssets" AfterTargets="Build" Condition="'$(HedraPackAssets)' != 'false'">
    <ItemGroup>
      <_PackedHedraAssets Include="$(MSBuildProjectDirectory)/../Hedra/bin/$(Configuration)/$(TargetFramework)/data1.db;$(MSBuildProjectDirectory)/../Hedra/bin/$(Configuration)/$(TargetFramework)/data2.db;$(MSBuildProjectDirectory)/../Hedra/bin/$(Configuration)/$(TargetFramework)/data3.db" />
    </ItemGroup>
    <Copy SourceFiles="@(_PackedHedraAssets)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
